# Copy to .env, paste your key there, then run npm start. Never commit .env.
TYPESAFE_API_KEY=
PORT=3137
BIND_HOST=127.0.0.1
TRANSCRIBE=browser
JEV_TIMEOUT_MS=6000
# Use a tested version when available to your account; otherwise use the alias.
TYPESAFE_MODEL=jev-latest

# Optional local transcript producer token, generated separately from production.
# AMD_LIVE_STT_INGEST_TOKEN=

# For HTTPS behind a trusted reverse proxy, set TRUST_PROXY=1 or PUBLIC_ORIGIN.
# PUBLIC_ORIGIN=https://coach.example.com

# Existing VoiceClaude recognition: no browser ASR model download.
# TRANSCRIBE=voiceclaude
# VOICECLAUDE_URL=http://127.0.0.1:8910
# Optional existing authenticated SSH tunnel to the personal GPU worker:
# VOICECLAUDE_GPU_URL=http://127.0.0.1:47212
